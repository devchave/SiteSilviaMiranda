# Programa EIXO Comercial — Silvia Miranda
# Cabeçalhos de cache: HTML sempre revalida (deploys aparecem na hora),
# assets estáticos versionados (?v=N) podem ficar em cache por muito tempo.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
